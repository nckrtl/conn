[Unit]
Description=Register this Conn Server with the Orbit Gateway (t3-orbit-register)
After=network-online.target
[Service]
Type=oneshot
# T3_ORBIT_REGISTER_URL=http://<wireguard address>:<port>, one line, in this file.
EnvironmentFile=%h/.config/t3-orbit-register.env
# A stable path to the server CLI; never a …/runtime/versions/<version>/ path.
ExecStart=%h/.local/bin/t3-orbit-register ${T3_ORBIT_REGISTER_URL} %h/.local/bin/conn-server
