{
  "$schema": "./scripts/fork-sync.schema.json",
  "version": 1,
  "upstream": {
    "remote": "upstream",
    "url": "https://github.com/pingdotgg/t3code.git",
    "ref": "main"
  },
  "conflictRules": [
    {
      "glob": "pnpm-lock.yaml",
      "strategy": "regenerate",
      "command": "vp i"
    },
    {
      "glob": "apps/web/src/components/chat/ChatComposer.tsx",
      "strategy": "theirs"
    },
    {
      "glob": "apps/web/src/composer*.ts",
      "strategy": "theirs"
    },
    {
      "glob": "apps/web/src/lib/composer*.ts",
      "strategy": "theirs"
    },
    {
      "glob": "apps/web/src/components/chat/composer*.ts",
      "strategy": "theirs"
    },
    {
      "glob": "apps/web/src/components/chat/useComposer*.ts",
      "strategy": "theirs"
    },
    {
      "glob": "FORK.md",
      "strategy": "ours"
    },
    {
      "glob": "fork-sync.json",
      "strategy": "ours"
    },
    {
      "glob": "settings-carryover.json",
      "strategy": "ours"
    },
    {
      "glob": "scripts/fork-sync.ts",
      "strategy": "ours"
    },
    {
      "glob": "scripts/fork-sync.schema.json",
      "strategy": "ours"
    },
    {
      "glob": "scripts/fork-sync.test.ts",
      "strategy": "ours"
    },
    {
      "glob": "scripts/orbit/**",
      "strategy": "ours"
    },
    {
      "glob": "assets/conn/**",
      "strategy": "ours"
    },
    {
      "glob": "apps/desktop/src/branding/**",
      "strategy": "ours"
    },
    {
      "glob": "patches/*-conn.patch",
      "strategy": "ours"
    },
    {
      "glob": "apps/web/src/orbit/**",
      "strategy": "ours"
    },
    {
      "glob": "apps/web/src/laravelToolbar/**",
      "strategy": "ours"
    },
    {
      "glob": "apps/web/src/api/**",
      "strategy": "ours"
    },
    {
      "glob": "apps/web/src/database/**",
      "strategy": "ours"
    },
    {
      "glob": "apps/web/src/mcp/**",
      "strategy": "ours"
    },
    {
      "glob": "apps/web/src/annotations/**",
      "strategy": "ours"
    },
    {
      "glob": "apps/web/src/workspace*.ts",
      "strategy": "ours"
    },
    {
      "glob": "apps/web/src/components/sidebar/Workspace*.tsx",
      "strategy": "ours"
    },
    {
      "glob": "apps/web/src/components/EnvironmentContextChip.tsx",
      "strategy": "ours"
    },
    {
      "glob": "packages/annotation-overlay/**",
      "strategy": "ours"
    },
    {
      "glob": "apps/server/src/orbit/**",
      "strategy": "ours"
    },
    {
      "glob": "apps/server/src/annotations/**",
      "strategy": "ours"
    },
    {
      "glob": "apps/server/src/wsFork.ts",
      "strategy": "ours"
    },
    {
      "glob": "apps/server/src/peer/**",
      "strategy": "ours"
    },
    {
      "glob": "apps/server/src/persistence/Migrations.ts",
      "strategy": "ours"
    },
    {
      "glob": "apps/mobile/modules/conn-symbols/**",
      "strategy": "ours"
    },
    {
      "glob": "apps/mobile/src/features/orbit/**",
      "strategy": "ours"
    }
  ],
  "guardTests": [
    "apps/mobile/src/native/connForkPatches.test.ts",
    "apps/web/src/icons/connIcons.test.ts",
    "apps/server/src/mcp/toolkits/connForkPreviewCopy.test.ts",
    "apps/desktop/src/window/DesktopWindow.test.ts"
  ],
  "settingsPolicy": "settings-carryover.json",
  "features": [
