diff --git a/ios/renderer/ListRenderer.m b/ios/renderer/ListRenderer.m
index 47283dc..917b50b 100644
--- a/ios/renderer/ListRenderer.m
+++ b/ios/renderer/ListRenderer.m
@@ -90,6 +90,16 @@ - (void)renderNodeContent:(MarkdownASTNode *)node
   // ListItemRenderer pre-increments, so the counter starts one below the
   // first rendered number.
   context.listItemNumber = startNumber - 1;
+  // Conn: size the marker column to this list's widest number, so "1." starts at the
+  // list's edge like a bullet does, instead of right-aligning in a "99." column.
+  if (_isOrdered) {
+    NSInteger lastNumber = startNumber + MAX((NSInteger)1, (NSInteger)node.children.count) - 1;
+    UIFont *markerFont = [_config listMarkerFont] ?: _config.listStyleFont;
+    NSString *widest = [NSString stringWithFormat:@"%ld.", (long)lastNumber];
+    context.listMarkerWidth = [widest sizeWithAttributes:@{NSFontAttributeName : markerFont}].width;
+  } else {
+    context.listMarkerWidth = [_config listStyleBulletSize];
+  }
 
   [context setBlockStyle:_isOrdered ? BlockTypeOrderedList : BlockTypeUnorderedList
                     font:_config.listStyleFont
