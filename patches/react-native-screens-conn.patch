+// Conn: with toolbar integration (iOS 26+), UIKit shows its own search text
+// field in the toolbar, not the search controller's field. Find the visible one.
+static UISearchTextField *_Nullable RNSVisibleSearchTextField(UIView *_Nullable root)
+{
+  if (root == nil) {
+    return nil;
+  }
+  NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
+  while (queue.count > 0) {
+    UIView *view = queue.firstObject;
+    [queue removeObjectAtIndex:0];
+    if ([view isKindOfClass:UISearchTextField.class] && view.window != nil && !view.hidden) {
+      return (UISearchTextField *)view;
+    }
+    [queue addObjectsFromArray:view.subviews];
+  }
+  return nil;
+}
+#endif // !TARGET_OS_TV
