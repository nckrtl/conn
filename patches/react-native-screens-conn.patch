+#if !TARGET_OS_TV
+// Conn: shows a toolbar menu item as a button on the trailing edge of the
+// toolbar search field, like Mail's filter. Passing nil removes the button.
+- (void)applySearchFieldAccessoryForItem:(nullable id<RNSHeaderItemDataProviding>)item
+{
+  UIButton *installed = _searchFieldAccessoryButton;
+  if (item == nil) {
+    if (installed != nil) {
+      UITextField *owner = (UITextField *)installed.superview;
+      if ([owner isKindOfClass:UITextField.class] && owner.rightView == installed) {
+        owner.rightView = nil;
+      }
+      [installed removeFromSuperview];
+    }
+    _searchFieldAccessoryButton = nil;
+    _searchFieldAccessoryItemId = nil;
+    return;
+  }
+  // Remember the item even before a search field exists: the search bar often
+  // mounts after the header items, and applySearchBar installs it then.
+  _searchFieldAccessoryItemId = item.itemId;
+
+  UIButton *button = [RNSSearchFieldAccessoryButton buttonWithType:UIButtonTypeSystem];
+  button.tintColor = UIColor.secondaryLabelColor;
+  button.accessibilityLabel = item.title;
+  button.accessibilityIdentifier = item.identifier;
+  UIImageSymbolConfiguration *symbolConfiguration =
+      [UIImageSymbolConfiguration configurationWithTextStyle:UIFontTextStyleBody scale:UIImageSymbolScaleMedium];
+  [button setPreferredSymbolConfiguration:symbolConfiguration forImageInState:UIControlStateNormal];
+  if (item.icon != nil) {
+    __weak UIButton *weakButton = button;
+    UIImage *syncImage = [RNSHeaderIconResolver resolveIcon:item.icon
+                                            withImageLoader:_imageLoader
+                                       asyncCompletionBlock:^(UIImage *_Nullable image) {
+                                         [weakButton setImage:image forState:UIControlStateNormal];
+                                       }];
+    [button setImage:syncImage ? syncImage : [RNSHeaderIconResolver placeholderImageForIcon:item.icon]
+            forState:UIControlStateNormal];
+  }
+  if (item.menu != nil && item.itemId != nil) {
+    RNSHeaderMenuToggleStateTracker *tracker = [_trackerRegistry trackerForItemId:item.itemId];
+    __weak auto weakSelf = self;
+    NSString *capturedItemId = item.itemId;
+    button.menu = [RNSHeaderMenuCoordinator buildUIMenuFromData:item.menu
+                                       withHeaderEventsDelegate:_eventsDelegate
+                                                   stateTracker:tracker
+                                                withImageLoader:_imageLoader
+                                        menuInvalidatedCallback:^{
+                                          [weakSelf reapplyMenuForItemWithId:capturedItemId];
+                                        }];
+    button.showsMenuAsPrimaryAction = YES;
+  }
+  [button sizeToFit];
+  CGRect frame = button.frame;
+  frame.size.width = MAX(frame.size.width, 30.0);
+  button.frame = frame;
+
+  if (installed != nil && installed != button) {
+    UITextField *owner = (UITextField *)installed.superview;
+    if ([owner isKindOfClass:UITextField.class] && owner.rightView == installed) {
+      owner.rightView = nil;
+    }
+    [installed removeFromSuperview];
+  }
+  _searchFieldAccessoryButton = button;
+  [self installSearchFieldAccessoryButton:button attempt:0];
+}
+
+// The toolbar's search field appears after UIKit lays out the toolbar, and
+// UIKit may replace it later, so look for it on the next run loop turns.
+- (void)installSearchFieldAccessoryButton:(UIButton *)button attempt:(NSInteger)attempt
+{
+  if (_searchFieldAccessoryButton != button) {
+    return;
+  }
+  UIViewController *controller = [self requireScreenController];
+  UINavigationController *navController = controller.navigationController;
+  UISearchTextField *field = RNSVisibleSearchTextField(navController.toolbar);
+  if (field == nil) {
+    field = RNSVisibleSearchTextField(navController.view);
+  }
+  if (field == nil) {
+    UISearchTextField *controllerField = controller.navigationItem.searchController.searchBar.searchTextField;
+    field = controllerField.window != nil ? controllerField : nil;
+  }
+  if (field != nil) {
+    // UIKit resets the fields' font when it moves the search bar into the
+    // toolbar, so apply the app's size (appearance settings) here, after that.
+    CGFloat fontSize = _appliedSearchBar.fontSize;
+    if (fontSize > 0) {
+      UIFont *font = [UIFont systemFontOfSize:fontSize];
+      UISearchTextField *controllerField = controller.navigationItem.searchController.searchBar.searchTextField;
+      for (UISearchTextField *target in controllerField != nil ? @[ field, controllerField ] : @[ field ]) {
+        target.adjustsFontForContentSizeCategory = NO;
+        if (![target.font isEqual:font]) {
+          target.font = font;
+        }
+      }
+    }
+    if (field.rightView != button) {
+      field.rightView = button;
+    }
+    // Always visible, also while typing (the clear button sits before it).
+    field.rightViewMode = UITextFieldViewModeAlways;
+  }
+  if (field == nil && attempt < 40) {
+    __weak auto weakSelf = self;
+    __weak UIButton *weakButton = button;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.05 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+      UIButton *strongButton = weakButton;
+      if (strongButton != nil) {
+        [weakSelf installSearchFieldAccessoryButton:strongButton attempt:attempt + 1];
+      }
+    });
+  }
+}
+#endif // !TARGET_OS_TV
+
 @end
