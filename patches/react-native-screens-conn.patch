+#if !TARGET_OS_TV
+// Conn: shows a toolbar menu item as a button on the trailing edge of the
+// toolbar search field, like Mail's filter. Passing nil removes the button.
+- (void)applySearchFieldAccessoryForItem:(nullable id<RNSHeaderItemDataProviding>)item
+{
+  UISearchTextField *field = [self requireScreenController].navigationItem.searchController.searchBar.searchTextField;
+  UIButton *installed = _searchFieldAccessoryButton;
+  if (installed != nil && installed.superview != nil && field.rightView != installed) {
+    // The search controller changed; drop the button from the old field.
+    [installed removeFromSuperview];
+  }
+  if (item == nil || field == nil) {
+    if (installed != nil && field.rightView == installed) {
+      field.rightView = nil;
+    }
+    _searchFieldAccessoryButton = nil;
+    return;
+  }
+
+  UIButton *button = [UIButton buttonWithType:UIButtonTypeSystem];
+  button.tintColor = UIColor.secondaryLabelColor;
+  button.accessibilityLabel = item.title;
+  button.accessibilityIdentifier = item.identifier;
+  UIImageSymbolConfiguration *symbolConfiguration =
+      [UIImageSymbolConfiguration configurationWithTextStyle:UIFontTextStyleBody scale:UIImageSymbolScaleMedium];
+  [button setPreferredSymbolConfiguration:symbolConfiguration forImageInState:UIControlStateNormal];
+  if (item.icon != nil) {
+    __weak UIButton *weakButton = button;
+    UIImage *syncImage = [RNSHeaderIconResolver resolveIcon:item.icon
+                                            withImageLoader:_imageLoader
+                                       asyncCompletionBlock:^(UIImage *_Nullable image) {
+                                         [weakButton setImage:image forState:UIControlStateNormal];
+                                       }];
+    [button setImage:syncImage ? syncImage : [RNSHeaderIconResolver placeholderImageForIcon:item.icon]
+            forState:UIControlStateNormal];
+  }
+  if (item.menu != nil && item.itemId != nil) {
+    RNSHeaderMenuToggleStateTracker *tracker = [_trackerRegistry trackerForItemId:item.itemId];
+    __weak auto weakSelf = self;
+    NSString *capturedItemId = item.itemId;
+    button.menu = [RNSHeaderMenuCoordinator buildUIMenuFromData:item.menu
+                                       withHeaderEventsDelegate:_eventsDelegate
+                                                   stateTracker:tracker
+                                                withImageLoader:_imageLoader
+                                        menuInvalidatedCallback:^{
+                                          [weakSelf reapplyMenuForItemWithId:capturedItemId];
+                                        }];
+    button.showsMenuAsPrimaryAction = YES;
+  }
+  [button sizeToFit];
+  CGRect frame = button.frame;
+  frame.size.width = MAX(frame.size.width, 30.0);
+  button.frame = frame;
+
+  field.rightView = button;
+  // While typing, the field's clear button takes the trailing edge.
+  field.rightViewMode = UITextFieldViewModeUnlessEditing;
+  _searchFieldAccessoryButton = button;
+}
+#endif // !TARGET_OS_TV
+
 @end
+
