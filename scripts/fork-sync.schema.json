{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nckrtl/conn/scripts/fork-sync.schema.json",
  "title": "Conn fork-sync manifest",
  "description": "Machine-readable fork customizations, conflict rules, and presence checks. Kept in step with FORK.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "upstream", "conflictRules", "features"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "url", "ref"],
      "properties": {
        "remote": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1, "description": "Branch to track, always main." }
      }
    },
    "conflictRules": {
      "type": "array",
      "description": "First matching glob wins. Unmatched conflicts stay unresolved (exit 3).",
      "items": { "$ref": "#/$defs/conflictRule" }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feature" }
    },
    "guardTests": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "settingsPolicy": {
      "type": "string",
      "description": "Repo-relative path to settings-carryover.json."
    }
  },
  "$defs": {
    "conflictStrategy": {
      "type": "string",
      "enum": ["ours", "theirs", "regenerate", "manual"]
    },
    "conflictRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glob", "strategy"],
      "properties": {
        "glob": { "type": "string", "minLength": 1 },
        "strategy": { "$ref": "#/$defs/conflictStrategy" },
        "command": {
          "type": "string",
          "description": "Required when strategy is regenerate. Run after taking theirs."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "strategy": { "const": "regenerate" } },
            "required": ["strategy"]
          },
          "then": { "required": ["command"] }
        }
      ]
    },
    "presenceCheck": {
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "file" },
            "path": { "type": "string", "minLength": 1 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "path", "symbol"],
          "properties": {
            "kind": { "const": "symbol" },
            "path": { "type": "string", "minLength": 1 },
            "symbol": { "type": "string", "minLength": 1 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "path", "route"],
          "properties": {
            "kind": { "const": "route" },
            "path": { "type": "string", "minLength": 1 },
            "route": { "type": "string", "minLength": 1 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "test" },
            "path": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "forkHeading", "files", "presence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "forkHeading": {
          "type": "string",
          "minLength": 1,
          "description": "Exact ### heading in FORK.md."
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "presence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/presenceCheck" }
        }
      }
    }
  }
}
