<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nckrtl.t3-orbit-relink</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>T3CODE_HOME</key>
    <string>/Users/nckrtl/.t3</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec /Users/nckrtl/.local/bin/t3-orbit-relink "$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments:0" /Users/nckrtl/Library/LaunchAgents/com.t3tools.t3code.service.plist)"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>86400</integer>
  <key>StandardOutPath</key>
  <string>/Users/nckrtl/Library/Logs/t3-orbit-relink.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/nckrtl/Library/Logs/t3-orbit-relink.log</string>
</dict>
</plist>
