#!/bin/sh
# Renews this host's linked environments through the Orbit Gateway before they expire.
#
#   t3-orbit-relink [--service-label LABEL] [T3 CLI COMMAND...]
#
# A link holds a session on the other environment that ends after 30 days, and nothing renews it.
# For each link that expires within RENEW_DAYS (default 10), this asks the Gateway for a pairing
# link to that environment (the Gateway holds an admin session on every registered T3 server) and
# links again with the same addresses and access. Linking again replaces the old link.
# The T3 CLI command defaults to `t3`. With --service-label, the CLI is the binary that launchd job runs
# now, found by t3-orbit-register --print-cli (installed next to this script). Run it daily, like
# t3-orbit-register (see FORK.md).
set -eu

if [ "${1:-}" = --service-label ]; then
    [ $# -eq 2 ] || { echo "usage: t3-orbit-relink [--service-label LABEL] [T3 CLI COMMAND...]" >&2; exit 64; }
    cli=$(sh "$(dirname "$0")/t3-orbit-register" --service-label "$2" --print-cli http://unused) || exit $?
    set -- "$cli"
fi
[ $# -ge 1 ] || set -- t3
gateway=${ORBIT_GATEWAY_URL:-https://gateway.orbit}
renew_days=${RENEW_DAYS:-10}

# A failed list must fail the run, not read as "no link expires".
links=$("$@" environment list --json) || { echo "t3-orbit-relink: \`$* environment list\` failed." >&2; exit 1; }
due=$(printf '%s' "$links" | jq -c --argjson days "$renew_days" '
  (now + $days * 86400) as $deadline
  | .[]
  | select(.status == "expired" or (.expiresAt | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) <= $deadline)')

[ -n "$due" ] || { echo "t3-orbit-relink: no link expires within $renew_days days."; exit 0; }

failed=0
while IFS= read -r link; do
    id=$(printf '%s' "$link" | jq -r .environmentId)
    label=$(printf '%s' "$link" | jq -r .label)
    access=$(printf '%s' "$link" | jq -r .access)
    url=$(printf '%s' "$link" | jq -r '.urls[0]')
    alternates=$(printf '%s' "$link" | jq -r '.urls[1:][] | "--url\n" + .')

    pairing=$(curl -fsS -m 30 -X POST -H 'Accept: application/json' \
        "$gateway/api/v1/conn/environments/$id/pairings") || {
        echo "t3-orbit-relink: the Gateway gave no pairing link for $label ($id)." >&2
        failed=1
        continue
    }
    code=$(printf '%s' "$pairing" | jq -r .data.pairing_url | sed -n 's/.*#token=//p')
    [ -n "$code" ] || { echo "t3-orbit-relink: no pairing code for $label ($id)." >&2; failed=1; continue; }

    # shellcheck disable=SC2086 # each alternate is a `--url ADDRESS` pair, one word per line
    if (IFS='
'; "$@" environment link "$url" $alternates --pairing-code "$code" --access "$access"); then
        :
    else
        echo "t3-orbit-relink: linking $label ($id) again failed." >&2
        failed=1
    fi
done <<LINKS
$due
LINKS
exit "$failed"
